---
import { holdPaths } from "./holdPaths";
import { uniqueId } from "../../lib/text";

interface Props {
  iconId: string;
  label: string;
  class?: string;
  showArrow?: boolean;
  /**
   * Hide from assistive tech - for cards where the hold's name is already
   * printed right next to the icon, so it isn't announced twice.
   */
  decorative?: boolean;
}

const { iconId, label, class: className = "", showArrow = true, decorative = false } = Astro.props;
const data = holdPaths[iconId];
// The arrowhead <marker> id must be unique per page - the holds index
// renders this component 18 times, and duplicate ids are invalid HTML.
const markerId = uniqueId(`hold-arrowhead-${iconId}`);

if (!data) {
  throw new Error(
    `HoldIcon: no shape registered for iconId "${iconId}" in holdPaths.ts`,
  );
}
---

<svg
  viewBox="0 0 100 100"
  class={className || "text-ink"}
  xmlns="http://www.w3.org/2000/svg"
  {...(decorative ? { "aria-hidden": "true" } : { role: "img", "aria-label": label })}
>
  {!decorative && <title>{label}</title>}
  {
    data.strokeOnly
      ? data.paths.map((d) => (
          <path
            d={d}
            fill="none"
            stroke="currentColor"
            stroke-width="4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        ))
      : data.paths.map((d) => <path d={d} fill="currentColor" />)
  }
  {
    data.holePaths?.map((d) => (
      <path d={d} fill="var(--color-paper)" />
    ))
  }
  {
    showArrow && data.arrow && (
      <line
        x1={data.arrow[0]}
        y1={data.arrow[1]}
        x2={data.arrow[2]}
        y2={data.arrow[3]}
        stroke="var(--color-rope)"
        stroke-width="3"
        stroke-dasharray="1 5"
        stroke-linecap="round"
        marker-end={`url(#${markerId})`}
      />
    )
  }
  {
    showArrow && data.arrow && (
      <defs>
        <marker
          id={markerId}
          markerWidth="6"
          markerHeight="6"
          refX="3"
          refY="3"
          orient="auto-start-reverse"
        >
          <path d="M0,0 L6,3 L0,6 Z" fill="var(--color-rope)" />
        </marker>
      </defs>
    )
  }
</svg>
