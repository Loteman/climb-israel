---
import { withBase } from "../../lib/url";
import type { CollectionEntry } from "astro:content";
import Card from "../ui/Card.astro";
import Badge from "../ui/Badge.astro";
import HoldIcon from "./HoldIcon.astro";
import { holdPaths } from "./holdPaths";
import { HOLD_FAMILY_LABELS, orderedKeys } from "../../lib/labels";

interface Props {
  holds: CollectionEntry<"hold-types">[];
}

const { holds } = Astro.props;

for (const hold of holds) {
  if (!holdPaths[hold.data.iconId]) {
    throw new Error(
      `HoldGallery: hold "${hold.id}" references iconId "${hold.data.iconId}" which has no shape in holdPaths.ts`,
    );
  }
}
---

<div class="space-y-14">
  {
    orderedKeys(HOLD_FAMILY_LABELS).map((family) => {
      const items = holds
        .filter((h) => h.data.family === family)
        .sort((a, b) => a.data.order - b.data.order);
      if (items.length === 0) return null;
      return (
        <section>
          <h2 class="font-display text-xl font-bold text-ink">
            {HOLD_FAMILY_LABELS[family]}
          </h2>
          <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {items.map((hold) => (
              <Card as="li" href={withBase(`/אחיזות-טיפוס/${hold.id}/`)}>
                <div class="flex items-start gap-4">
                  <HoldIcon
                    iconId={hold.data.iconId}
                    label={hold.data.nameHe}
                    class="h-14 w-14 shrink-0 text-rust group-hover:text-rope"
                    decorative
                  />
                  <div>
                    <p class="font-display font-bold text-ink group-hover:text-rust">
                      {hold.data.nameHe}
                    </p>
                    <Badge variant="stone" class="mt-1">
                      {hold.data.nameEn}
                    </Badge>
                    <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                      {hold.data.summary}
                    </p>
                  </div>
                </div>
              </Card>
            ))}
          </ul>
        </section>
      );
    })
  }
</div>
