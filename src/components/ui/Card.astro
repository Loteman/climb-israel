---
interface Props {
  as?: "div" | "li" | "article";
  class?: string;
  href?: string;
  /** Tighter padding below `sm`, for cards laid out two per row on phones. */
  compact?: boolean;
}

const { as: Tag = "div", class: className = "", href, compact = false } = Astro.props;
const paddingClass = compact ? "p-3 sm:p-5" : "p-5";
const linkClass = `group relative block border border-stone/50 bg-paper-dark ${paddingClass} transition-colors hover:border-rust ${className}`;
---

{
  href ? (
    Tag === "li" ? (
      // A list card is an <li> holding the link (a bare <a> can't be a
      // child of <ul>/<ol>); the link fills the li so grid rows stay even.
      <li class="flex">
        <a href={href} class={`${linkClass} w-full`}>
          <span
            class="absolute end-3 top-0 h-3 w-px bg-stone/50 transition-colors group-hover:bg-rust"
            aria-hidden="true"
          />
          <slot />
        </a>
      </li>
    ) : (
      <a href={href} class={linkClass}>
        <span
          class="absolute end-3 top-0 h-3 w-px bg-stone/50 transition-colors group-hover:bg-rust"
          aria-hidden="true"
        />
        <slot />
      </a>
    )
  ) : (
    <Tag class={`relative border border-stone/50 bg-paper-dark ${paddingClass} ${className}`}>
      <span
        class="absolute end-3 top-0 h-3 w-px bg-stone/50"
        aria-hidden="true"
      />
      <slot />
    </Tag>
  )
}
