---
interface Crumb {
  href: string;
  label: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: item.label,
    item: new URL(item.href, Astro.site).toString(),
  })),
};
---

<nav aria-label="פירורי לחם" class="font-body text-xs text-ink-soft">
  <ol class="flex flex-wrap items-center gap-1">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1">
          {i > 0 && <span aria-hidden="true">/</span>}
          {i === items.length - 1 ? (
            <span class="text-ink" aria-current="page">
              {item.label}
            </span>
          ) : (
            <a href={item.href} class="hover:text-rust">
              {item.label}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
