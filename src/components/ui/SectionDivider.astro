---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<svg
  class={`h-6 w-full text-stone/60 ${className}`}
  viewBox="0 0 400 24"
  preserveAspectRatio="none"
  aria-hidden="true"
>
  <polyline
    points="0,18 30,10 55,20 80,6 110,16 140,4 170,18 200,12 230,20 260,8 290,16 320,2 350,14 380,20 400,10"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linejoin="round"
    stroke-linecap="round"></polyline>
</svg>
