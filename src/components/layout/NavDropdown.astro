---
import { withBase } from "../../lib/url";
import { currentPathname, linkState } from "../../lib/active-link";
import type { NavLink } from "../../lib/site-nav";

interface Group {
  label: string;
  items: NavLink[];
}

interface Props {
  label: string;
  items?: NavLink[];
  groups?: Group[];
}

const { label, items, groups } = Astro.props;
const path = currentPathname(Astro.url);
const allGroups: Group[] = groups ?? [{ label: "", items: items ?? [] }];
const active = allGroups.some((g) => g.items.some((item) => linkState(path, item.href)));
---

<details class="group relative">
  <summary
    class:list={[
      "flex cursor-pointer list-none items-center gap-1 rounded-sm px-3 py-2 font-body text-sm font-semibold transition-colors [&::-webkit-details-marker]:hidden",
      active ? "text-rope" : "text-ink-soft hover:text-rust",
    ]}
  >
    <span>{label}</span>
    <svg width="10" height="6" viewBox="0 0 10 6" class="transition-transform group-open:rotate-180" aria-hidden="true">
      <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </summary>
  <div class="absolute start-0 top-full z-50 mt-2 w-56 border border-stone/50 bg-paper-dark p-2 shadow-lg">
    {
      allGroups.map((group, i) => (
        <Fragment>
          {i > 0 && <div class="my-1 border-t border-stone/40" />}
          {group.label && (
            <p class="px-3 pt-1.5 pb-1 font-body text-xs font-bold text-ink-soft">{group.label}</p>
          )}
          {group.items.map((item) => {
            const state = linkState(path, item.href);
            return (
              <a
                href={withBase(item.href)}
                aria-current={state}
                class:list={[
                  "block rounded-sm px-3 py-2 font-body text-sm font-semibold hover:bg-paper hover:text-rust",
                  state ? "text-rope" : "text-ink",
                ]}
              >
                {item.label}
              </a>
            );
          })}
        </Fragment>
      ))
    }
  </div>
</details>
