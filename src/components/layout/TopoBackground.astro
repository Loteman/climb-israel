---
interface Props {
  class?: string;
  opacity?: number;
}

const { class: className = "", opacity = 0.35 } = Astro.props;
---

<svg
  class={`pointer-events-none absolute inset-0 h-full w-full ${className}`}
  style={`opacity: ${opacity}`}
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  preserveAspectRatio="none"
>
  <defs>
    <pattern
      id="topo-contours"
      width="240"
      height="160"
      patternUnits="userSpaceOnUse"
    >
      <path
        d="M-20 20 C 40 0, 80 40, 140 20 S 240 0, 280 20"
        fill="none"
        stroke="var(--color-contour)"
        stroke-width="1"
      ></path>
      <path
        d="M-20 55 C 30 35, 90 75, 150 55 S 230 35, 280 55"
        fill="none"
        stroke="var(--color-contour)"
        stroke-width="1"
      ></path>
      <path
        d="M-20 90 C 50 70, 70 110, 140 90 S 220 70, 280 90"
        fill="none"
        stroke="var(--color-contour)"
        stroke-width="1"
      ></path>
      <path
        d="M-20 125 C 40 105, 90 145, 150 125 S 240 105, 280 125"
        fill="none"
        stroke="var(--color-contour)"
        stroke-width="1"
      ></path>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill="url(#topo-contours)"></rect>
</svg>
