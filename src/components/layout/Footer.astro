---
import SectionDivider from "../ui/SectionDivider.astro";
import { withBase } from "../../lib/url";
import {
  ABOUT_LINK,
  ACCESSIBILITY_LINK,
  BEGINNER_GUIDE,
  ENVIRONMENT_LINKS,
  GUIDES,
  HISTORY_LINK,
  LOCATIONS_LINK,
} from "../../lib/site-nav";
import { LICENSOR_NAME, LICENSOR_URL, SITE_NAME, contactUrl } from "../../site-config";

const columns = [
  { title: "מדריכים", links: GUIDES },
  {
    title: "אתר",
    links: [
      BEGINNER_GUIDE,
      ...ENVIRONMENT_LINKS,
      { ...LOCATIONS_LINK, label: "מקומות טיפוס בישראל" },
      HISTORY_LINK,
      { ...ABOUT_LINK, label: "אודות הפרויקט" },
    ],
  },
];
---

<footer class="border-t border-stone/40 bg-paper-dark">
  <SectionDivider class="text-stone/40" />
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="grid gap-8 sm:grid-cols-[2fr_1fr_1fr]">
      <div>
        <p class="font-display text-lg font-bold text-ink">{SITE_NAME}</p>
        <p class="mt-2 max-w-sm text-sm leading-relaxed text-ink-soft">
          מאגר מידע חינמי וקהילתי לטיפוס בישראל - בולדרינג וטיפוס בטבע. המידע
          נאסף ומתעדכן בהתנדבות; שעות פתיחה, מחירים ותנאי שטח עשויים להשתנות
          - כדאי לוודא מול המקור לפני יציאה.
        </p>
        <a
          href={contactUrl(`${SITE_NAME} - דיווח על טעות`)}
          class="mt-3 inline-block font-body text-sm font-bold text-rope hover:underline"
        >
          מצאתם טעות? דווחו לנו ←
        </a>
      </div>
      {
        columns.map((col) => (
          <nav aria-label={col.title}>
            <p class="font-body text-xs font-bold tracking-wide text-ink-soft">{col.title}</p>
            <ul class="mt-3 space-y-2">
              {col.links.map((link) => (
                <li>
                  <a href={withBase(link.href)} class="text-sm text-ink hover:text-rust">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <div class="mt-10 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 font-body text-xs text-ink-soft">
      <p>
        © {new Date().getFullYear()}{" "}
        <a href={LICENSOR_URL} target="_blank" rel="noopener noreferrer" class="hover:text-rust" dir="ltr">{LICENSOR_NAME}</a>{" "}
        · טפסו בזהירות, תמיד עם אבטחה מתאימה.
      </p>
      <p class="flex flex-wrap gap-x-4 gap-y-1">
        <a href={withBase(`${ABOUT_LINK.href}#sources`)} class="hover:text-rust">זכויות יוצרים</a>
        <a href={withBase(ACCESSIBILITY_LINK.href)} class="hover:text-rust">{ACCESSIBILITY_LINK.label}</a>
      </p>
    </div>
  </div>
</footer>
