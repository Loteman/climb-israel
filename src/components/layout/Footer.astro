---
import SectionDivider from "../ui/SectionDivider.astro";

const columns = [
  {
    title: "מדריכים",
    links: [
      { href: "/אחיזות-טיפוס/", label: "אחיזות טיפוס" },
      { href: "/מושגי-טיפוס/", label: "מושגי טיפוס" },
      { href: "/טכניקות-טיפוס/", label: "טכניקות טיפוס" },
      { href: "/מניעת-פציעות/", label: "מניעת פציעות" },
      { href: "/דירוג-מסלולים/", label: "דירוג מסלולים" },
      { href: "/סגנונות-טיפוס/", label: "סגנונות טיפוס" },
      { href: "/ציוד-טיפוס/", label: "ציוד טיפוס" },
    ],
  },
  {
    title: "אתר",
    links: [
      { href: "/מדריך-למתחילים/", label: "מדריך למתחילים" },
      { href: "/טיפוס-באולם/", label: "טיפוס באולם" },
      { href: "/טיפוס-בטבע/", label: "טיפוס בטבע" },
      { href: "/מקומות-טיפוס/", label: "מקומות טיפוס בישראל" },
      { href: "/אודות/", label: "אודות הפרויקט" },
    ],
  },
];
---

<footer class="border-t border-stone/40 bg-paper-dark">
  <SectionDivider class="text-stone/40" />
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="grid gap-8 sm:grid-cols-[2fr_1fr_1fr]">
      <div>
        <p class="font-display text-lg font-bold text-ink">טיפוס ישראל</p>
        <p class="mt-2 max-w-sm text-sm leading-relaxed text-ink-soft">
          מאגר מידע חינמי וקהילתי לטיפוס בישראל - בולדרינג וטיפוס בטבע. המידע
          נאסף ומתעדכן בהתנדבות; שעות פתיחה, מחירים ותנאי שטח עשויים להשתנות
          - כדאי לוודא מול המקור לפני יציאה.
        </p>
      </div>
      {
        columns.map((col) => (
          <div>
            <p class="font-body text-xs font-bold uppercase tracking-wide text-ink-soft">
              {col.title}
            </p>
            <ul class="mt-3 space-y-2">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-ink hover:text-rust"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="mt-10 font-body text-xs text-ink-soft">
      © {new Date().getFullYear()} טיפוס ישראל · טפסו בזהירות, תמיד עם ביטחון
      מתאים.
    </p>
  </div>
</footer>
