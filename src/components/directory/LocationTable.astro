---
import { withBase } from "../../lib/url";
import type { CollectionEntry } from "astro:content";
import Badge from "../ui/Badge.astro";
import NavigationButtons from "./NavigationButtons.astro";

interface Props {
  locations: CollectionEntry<"locations">[];
}

const { locations } = Astro.props;

const styleLabels: Record<string, string> = {
  bouldering: "בולדרינג",
  lead: "הובלה",
  "top-rope": "טופ-רופ",
  speed: "טיפוס מהירות",
  trad: "טראד",
  "multi-pitch": "מולטי-פיץ'",
  "via-ferrata": "ויה פראטה",
};

const regionLabels: Record<string, string> = {
  north: "צפון",
  sharon: "שרון",
  center: "מרכז",
  shfela: "שפלה",
  jerusalem: "אזור ירושלים",
  yosh: "יהודה ושומרון",
  south: "דרום",
};
---

<div class="overflow-x-auto border border-stone/50">
  <table class="w-full min-w-[760px] border-collapse text-start">
    <thead>
      <tr class="border-b border-stone/50 bg-paper-dark">
        <th class="p-3 text-start font-display text-sm font-bold text-ink">שם</th>
        <th class="p-3 text-start font-display text-sm font-bold text-ink">אזור</th>
        <th class="p-3 text-start font-display text-sm font-bold text-ink">מיקום</th>
        <th class="p-3 text-start font-display text-sm font-bold text-ink">סגנון</th>
        <th class="p-3 text-start font-display text-sm font-bold text-ink">ניווט</th>
        <th class="p-3 text-start font-display text-sm font-bold text-ink">נוסף</th>
      </tr>
    </thead>
    <tbody>
      {
        locations.map((location, i) => {
          const { data } = location;
          const navQuery =
            data.kind === "gym"
              ? [data.address, data.city].filter(Boolean).join(", ")
              : (data.locationDescription ?? data.name);
          const locationText =
            data.kind === "gym"
              ? [data.city, data.address].filter(Boolean).join(", ")
              : (data.locationDescription ?? "אין מידע");
          const searchText = [
            data.name,
            data.kind === "gym" ? data.city : "",
            regionLabels[data.region],
            data.kind === "gym" ? (data.chain ?? "") : "",
            data.kind === "gym" ? (data.address ?? "") : "",
          ]
            .join(" ")
            .toLowerCase();

          return (
            <tr
              data-location-card
              data-location-id={location.id}
              data-kind={data.kind}
              data-styles={data.styles.join(",")}
              data-region={data.region}
              data-search={searchText}
              class={i % 2 === 1 ? "bg-paper-dark/40" : ""}
            >
              <td class="border-t border-stone/30 p-3 align-top">
                <a
                  href={withBase(`/מקומות-טיפוס/${location.id}/`)}
                  class="font-display font-bold text-ink hover:text-rust"
                >
                  {data.name}
                </a>
                {data.kind === "gym" && data.chain && (
                  <div class="mt-0.5 font-mono text-xs text-ink-soft">{data.chain}</div>
                )}
              </td>
              <td class="border-t border-stone/30 p-3 align-top text-sm text-ink-soft">
                {regionLabels[data.region]}
              </td>
              <td class="border-t border-stone/30 p-3 align-top text-sm leading-relaxed text-ink-soft">
                {locationText}
              </td>
              <td class="border-t border-stone/30 p-3 align-top">
                <div class="flex flex-wrap gap-1">
                  {data.styles.map((s: string) => (
                    <Badge variant="stone">{styleLabels[s]}</Badge>
                  ))}
                </div>
              </td>
              <td class="border-t border-stone/30 p-3 align-top">
                <NavigationButtons query={navQuery} size="sm" />
              </td>
              <td class="border-t border-stone/30 p-3 align-top">
                {data.kind === "gym" ? (
                  <div class="flex flex-col items-start gap-1 text-sm">
                    {data.phone && (
                      <a
                        href={`tel:${data.phone.replace(/[^0-9+]/g, "")}`}
                        class="font-bold text-ink hover:text-rust"
                      >
                        {data.phone}
                      </a>
                    )}
                    {data.website && (
                      <a
                        href={data.website}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-bold text-rope hover:underline"
                      >
                        אתר ←
                      </a>
                    )}
                  </div>
                ) : data.guidebooks?.[0] ? (
                  <a
                    href={data.guidebooks[0].url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex w-fit items-center gap-1.5 border border-stone/60 px-2.5 py-1.5 font-body text-xs font-bold text-ink transition-colors hover:border-rust hover:text-rust"
                  >
                    גיידבוק
                  </a>
                ) : (
                  <span class="text-xs text-ink-soft">-</span>
                )}
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>
