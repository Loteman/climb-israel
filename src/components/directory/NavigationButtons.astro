---
import { googleMapsUrl, wazeUrl, type NavTarget } from "../../lib/navigation";

interface Props {
  /** Address text or exact coordinates - see src/lib/navigation.ts. */
  target: NavTarget;
  /** Place name, so screen readers hear which place each of the ~90 otherwise-identical links is for. */
  placeName: string;
  class?: string;
  size?: "sm" | "md";
}

const { target, placeName, class: className = "", size = "md" } = Astro.props;
// "sm" is compact on desktop but keeps a 40px-tall tap target on phones.
const sizeClass =
  size === "sm" ? "min-h-10 px-3 text-xs sm:min-h-0 sm:px-2.5 sm:py-1.5" : "min-h-10 px-3 py-2 text-sm";
const linkClass = `flex items-center gap-1.5 whitespace-nowrap border border-stone/60 font-body font-bold text-ink transition-colors hover:border-rust hover:text-rust ${sizeClass}`;
---

<div class={`flex gap-2 ${className}`}>
  <a
    href={googleMapsUrl(target)}
    target="_blank"
    rel="noopener noreferrer"
    class={linkClass}
    aria-label={`ניווט במפות (Google Maps) אל ${placeName} - נפתח בחלון חדש`}
  >
    <svg width="14" height="14" aria-hidden="true"><use href="#icon-map-pin"></use></svg>
    ניווט במפות
  </a>
  <a
    href={wazeUrl(target)}
    target="_blank"
    rel="noopener noreferrer"
    class={linkClass}
    aria-label={`Waze - ניווט אל ${placeName} - נפתח בחלון חדש`}
  >
    <svg width="16" height="16" aria-hidden="true"><use href="#icon-waze"></use></svg>
    Waze
  </a>
</div>
