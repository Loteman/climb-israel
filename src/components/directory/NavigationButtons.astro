---
import { googleMapsUrl, wazeUrl } from "../../lib/navigation";

interface Props {
  /** Free-text place/address to hand to Maps/Waze - they geocode it server-side. */
  query: string;
  class?: string;
  size?: "sm" | "md";
}

const { query, class: className = "", size = "md" } = Astro.props;
const sizeClass = size === "sm" ? "px-2.5 py-1.5 text-xs" : "px-3 py-2 text-sm";
---

<div class={`flex gap-2 ${className}`}>
  <a
    href={googleMapsUrl(query)}
    target="_blank"
    rel="noopener noreferrer"
    class={`flex items-center gap-1.5 border border-stone/60 font-body font-bold text-ink transition-colors hover:border-rust hover:text-rust ${sizeClass}`}
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 2C7.6 2 4 5.6 4 10c0 5.4 7 11.5 7.3 11.8a1 1 0 0 0 1.4 0C13 21.5 20 15.4 20 10c0-4.4-3.6-8-8-8Z" stroke="currentColor" stroke-width="1.6" />
      <circle cx="12" cy="10" r="2.6" stroke="currentColor" stroke-width="1.6" />
    </svg>
    ניווט במפות
  </a>
  <a
    href={wazeUrl(query)}
    target="_blank"
    rel="noopener noreferrer"
    class={`flex items-center gap-1.5 border border-stone/60 font-body font-bold text-ink transition-colors hover:border-rust hover:text-rust ${sizeClass}`}
  >
    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M12 2C6.7 2 2.4 6 2.4 11c0 2.9 1.5 5.5 3.8 7.2l-.5 2.7c-.1.5.4.9.9.6l2.9-1.7c.8.2 1.6.3 2.5.3 5.3 0 9.6-4 9.6-9.1S17.3 2 12 2Z"
        fill="currentColor"
      ></path>
      <circle cx="9" cy="10.6" r="1.3" fill="var(--color-paper)"></circle>
      <circle cx="15" cy="10.6" r="1.3" fill="var(--color-paper)"></circle>
      <path
        d="M8.5 13.8c1 1 2.1 1.5 3.5 1.5s2.5-.5 3.5-1.5"
        stroke="var(--color-paper)"
        stroke-width="1.3"
        stroke-linecap="round"
        fill="none"
      ></path>
    </svg>
    Waze
  </a>
</div>
