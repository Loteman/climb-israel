---
import { withBase, withBaseIfRelative } from "../../lib/url";
import type { CollectionEntry } from "astro:content";
import Badge from "../ui/Badge.astro";
import NavigationButtons from "./NavigationButtons.astro";
import { REGION_LABELS, STYLE_LABELS } from "../../lib/labels";
import {
  downloadableGuidebook,
  hasGuidebook,
  locationNavTarget,
  locationSearchText,
} from "../../lib/locations";

interface Props {
  location: CollectionEntry<"locations">;
}

const { location } = Astro.props;
const { data } = location;
const guidebook = downloadableGuidebook(location);
---

<li
  data-location-card
  data-location-id={location.id}
  data-kind={data.kind}
  data-styles={data.styles.join(",")}
  data-region={data.region}
  data-guidebook={hasGuidebook(location) ? "true" : undefined}
  data-search={locationSearchText(location)}
  class="border border-stone/50 bg-paper-dark p-5"
>
  <h2 class="font-display text-base font-bold">
    <a
      href={withBase(`/מקומות-טיפוס/${location.id}/`)}
      class="text-ink hover:text-rust"
    >
      {data.name}
    </a>
  </h2>

  <p class="mt-1 text-sm text-ink-soft">
    {REGION_LABELS[data.region]}
    {data.kind === "gym" && data.chain ? ` · ${data.chain}` : ""}
  </p>
  {
    data.kind === "gym" && (
      <p class="text-sm text-ink-soft">
        {[data.city, data.address].filter(Boolean).join(", ")}
      </p>
    )
  }

  {
    data.kind === "crag" && data.locationDescription && (
      <p class="text-sm leading-relaxed text-ink-soft">
        <span class="font-body text-xs font-bold text-ink-soft">מיקום: </span>
        {data.locationDescription}
      </p>
    )
  }

  <div class="mt-3 flex flex-wrap gap-1.5">
    {data.styles.map((s) => <Badge variant="stone">{STYLE_LABELS[s]}</Badge>)}
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-2">
    <NavigationButtons target={locationNavTarget(location)} placeName={data.name} size="sm" />
    {
      guidebook && (
        <a
          href={withBaseIfRelative(guidebook.url)}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 border border-stone/60 px-2.5 py-1.5 font-body text-xs font-bold text-ink transition-colors hover:border-rust hover:text-rust"
          aria-label={`גיידבוק - ${data.name} (נפתח בחלון חדש)`}
        >
          <svg width="14" height="14" aria-hidden="true"><use href="#icon-download"></use></svg>
          גיידבוק
        </a>
      )
    }
  </div>
</li>
