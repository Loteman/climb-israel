---
import { withBase } from "../../lib/url";
import type { CollectionEntry } from "astro:content";
import Badge from "../ui/Badge.astro";
import NavigationButtons from "./NavigationButtons.astro";

interface Props {
  location: CollectionEntry<"locations">;
}

const { location } = Astro.props;
const { data } = location;

const styleLabels: Record<string, string> = {
  bouldering: "בולדרינג",
  lead: "הובלה",
  "top-rope": "טופ-רופ",
  speed: "טיפוס מהירות",
  trad: "טראד",
  "multi-pitch": "מולטי-פיץ'",
  "via-ferrata": "ויה פראטה",
};

const regionLabels: Record<string, string> = {
  north: "צפון",
  sharon: "שרון",
  center: "מרכז",
  shfela: "שפלה",
  jerusalem: "אזור ירושלים",
  yosh: "יהודה ושומרון",
  south: "דרום",
};

const navQuery =
  data.kind === "gym"
    ? [data.address, data.city].filter(Boolean).join(", ")
    : (data.locationDescription ?? data.name);

const searchText = [
  data.name,
  data.kind === "gym" ? data.city : "",
  regionLabels[data.region],
  data.kind === "gym" ? (data.chain ?? "") : "",
  data.kind === "gym" ? (data.address ?? "") : "",
]
  .join(" ")
  .toLowerCase();
---

<li
  data-location-card
  data-location-id={location.id}
  data-kind={data.kind}
  data-styles={data.styles.join(",")}
  data-region={data.region}
  data-search={searchText}
  class="border border-stone/50 bg-paper-dark p-5"
>
  <a
    href={withBase(`/מקומות-טיפוס/${location.id}/`)}
    class="font-display font-bold text-ink hover:text-rust"
  >
    {data.name}
  </a>

  <p class="mt-1 text-sm text-ink-soft">
    {regionLabels[data.region]}
    {data.kind === "gym" && data.chain ? ` · ${data.chain}` : ""}
  </p>
  {
    data.kind === "gym" && (
      <p class="text-sm text-ink-soft">
        {[data.city, data.address].filter(Boolean).join(", ")}
      </p>
    )
  }

  {
    data.kind === "crag" && data.locationDescription && (
      <p class="text-sm leading-relaxed text-ink-soft">
        <span class="font-body text-xs font-bold uppercase tracking-wide text-ink-soft/80">
          מיקום:{" "}
        </span>
        {data.locationDescription}
      </p>
    )
  }

  <div class="mt-3 flex flex-wrap gap-1.5">
    {
      data.styles.map((s) => (
        <Badge variant="stone">{styleLabels[s]}</Badge>
      ))
    }
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-2">
    <NavigationButtons query={navQuery} size="sm" />
    {
      data.kind === "crag" && data.guidebooks?.[0] && (
        <a
          href={data.guidebooks[0].url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 border border-stone/60 px-2.5 py-1.5 font-body text-xs font-bold text-ink transition-colors hover:border-rust hover:text-rust"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M12 3v12m0 0l-4.5-4.5M12 15l4.5-4.5M5 19h14"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          גיידבוק
        </a>
      )
    }
  </div>
</li>
