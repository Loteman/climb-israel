---
import type { CollectionEntry } from "astro:content";
import Badge from "../ui/Badge.astro";

interface Props {
  disciplines: CollectionEntry<"disciplines">[];
}

const { disciplines } = Astro.props;
const sorted = [...disciplines].sort((a, b) => a.data.order - b.data.order);

// The first 4 (by `order`) are the styles most climbers actually encounter
// day to day - shown as the "main" set, with everything else grouped under
// a "נוספים" (additional) divider so the table doesn't read as 11 flat,
// equally-weighted rows.
const primary = sorted.slice(0, 4);
const rest = sorted.slice(4);

const envLabels: Record<string, string> = {
  indoor: "קיר סגור",
  outdoor: "טבע",
  both: "קיר וטבע",
};
const envVariant: Record<string, "rope" | "olive" | "rust"> = {
  indoor: "rope",
  outdoor: "olive",
  both: "rust",
};
---

<div class="hidden overflow-hidden border border-stone/50 sm:block">
  <table class="w-full border-collapse text-start">
    <thead>
      <tr class="border-b border-stone/50 bg-paper-dark">
        <th class="p-4 text-start font-display text-sm font-bold text-ink">סגנון</th>
        <th class="p-4 text-start font-display text-sm font-bold text-ink">סביבה</th>
        <th class="p-4 text-start font-display text-sm font-bold text-ink">מה זה</th>
      </tr>
    </thead>
    <tbody>
      {
        primary.map((d, i) => (
          <tr class={i % 2 === 1 ? "bg-paper-dark/40" : ""}>
            <td class="border-t border-stone/30 p-4 align-top">
              <a
                href={`/סגנונות-טיפוס/${d.id}/`}
                class="font-display font-bold text-ink hover:text-rust"
              >
                {d.data.nameHe}
              </a>
              <div class="mt-0.5 font-mono text-xs text-ink-soft">
                {d.data.nameEn}
              </div>
            </td>
            <td class="border-t border-stone/30 p-4 align-top">
              <Badge variant={envVariant[d.data.environment]}>
                {envLabels[d.data.environment]}
              </Badge>
            </td>
            <td class="border-t border-stone/30 p-4 align-top text-sm leading-relaxed text-ink-soft">
              {d.data.summary}
            </td>
          </tr>
        ))
      }
      {
        rest.length > 0 && (
          <tr>
            <td
              colspan="3"
              class="border-t border-stone/30 bg-paper-dark p-2 font-body text-xs font-bold uppercase tracking-wide text-ink-soft"
            >
              נוספים
            </td>
          </tr>
        )
      }
      {
        rest.map((d, i) => (
          <tr class={i % 2 === 1 ? "bg-paper-dark/40" : ""}>
            <td class="border-t border-stone/30 p-4 align-top">
              <a
                href={`/סגנונות-טיפוס/${d.id}/`}
                class="font-display font-bold text-ink hover:text-rust"
              >
                {d.data.nameHe}
              </a>
              <div class="mt-0.5 font-mono text-xs text-ink-soft">
                {d.data.nameEn}
              </div>
            </td>
            <td class="border-t border-stone/30 p-4 align-top">
              <Badge variant={envVariant[d.data.environment]}>
                {envLabels[d.data.environment]}
              </Badge>
            </td>
            <td class="border-t border-stone/30 p-4 align-top text-sm leading-relaxed text-ink-soft">
              {d.data.summary}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<ul class="space-y-3 sm:hidden">
  {
    primary.map((d) => (
      <li class="border border-stone/50 bg-paper-dark p-4">
        <a href={`/סגנונות-טיפוס/${d.id}/`} class="font-display font-bold text-ink">
          {d.data.nameHe}
        </a>
        <div class="mt-1 flex items-center gap-2">
          <Badge variant={envVariant[d.data.environment]}>
            {envLabels[d.data.environment]}
          </Badge>
          <span class="font-mono text-xs text-ink-soft">{d.data.nameEn}</span>
        </div>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">{d.data.summary}</p>
      </li>
    ))
  }
</ul>

{
  rest.length > 0 && (
    <>
      <p class="mt-6 font-body text-xs font-bold uppercase tracking-wide text-ink-soft sm:hidden">
        נוספים
      </p>
      <ul class="mt-3 space-y-3 sm:hidden">
        {rest.map((d) => (
          <li class="border border-stone/50 bg-paper-dark p-4">
            <a href={`/סגנונות-טיפוס/${d.id}/`} class="font-display font-bold text-ink">
              {d.data.nameHe}
            </a>
            <div class="mt-1 flex items-center gap-2">
              <Badge variant={envVariant[d.data.environment]}>
                {envLabels[d.data.environment]}
              </Badge>
              <span class="font-mono text-xs text-ink-soft">{d.data.nameEn}</span>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{d.data.summary}</p>
          </li>
        ))}
      </ul>
    </>
  )
}
