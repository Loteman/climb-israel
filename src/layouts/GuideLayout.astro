---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";

interface Crumb {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  breadcrumbs: Crumb[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: "website" | "article";
}

const { title, description, breadcrumbs, jsonLd, ogType = "article" } = Astro.props;
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} ogType={ogType}>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={breadcrumbs} />
    <article class="mt-6">
      <slot />
    </article>
  </div>
</BaseLayout>
