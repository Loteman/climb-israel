---
import "../styles/global.css";
import SeoHead from "../components/seo/SeoHead.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { withBase } from "../lib/url";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, jsonLd, noindex } = Astro.props;
const swUrl = withBase("/sw.js");
---

<!doctype html>
<html dir="rtl" lang="he">
  <head>
    <script is:inline>
      // Runs before first paint to avoid a flash of the wrong theme. Only
      // sets data-theme when the user explicitly picked light/dark -
      // "system" (the default) has no stored value at all, so the
      // prefers-color-scheme CSS in global.css handles it with zero JS.
      try {
        var t = localStorage.getItem("climb-israel-theme");
        if (t === "light" || t === "dark") {
          document.documentElement.setAttribute("data-theme", t);
        }
      } catch (e) {}
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3ede0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#211f1c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase("/icons/icon-192.png")} />
    <link rel="manifest" href={withBase("/manifest.webmanifest")} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="טיפוס ישראל" />
    <SeoHead title={title} description={description} jsonLd={jsonLd} noindex={noindex} />
  </head>
  <body class="flex min-h-screen flex-col font-body">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-[100] focus:bg-rope focus:px-4 focus:py-2 focus:text-paper"
    >
      דלג לתוכן הראשי
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script define:vars={{ swUrl }}>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register(swUrl).catch(() => {
            /* offline support is a progressive enhancement - ignore failures */
          });
        });
      }
    </script>
  </body>
</html>
