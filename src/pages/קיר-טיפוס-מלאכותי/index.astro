---
import { withBase } from "../../lib/url";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopoBackground from "../../components/layout/TopoBackground.astro";
import Badge from "../../components/ui/Badge.astro";
import SectionDivider from "../../components/ui/SectionDivider.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "קיר טיפוס (מלאכותי) - מדריך מלא",
  description:
    "מה ההבדל בין בולדרינג להובלה בקיר טיפוס מלאכותי, איזה ציוד צריך לכל אחד, וכללי בטיחות והתנהגות בקיר מלאכותי.",
};
---

<BaseLayout
  title="קיר טיפוס (מלאכותי) - מדריך מלא"
  description="מדריך לטיפוס בקיר מלאכותי: ההבדל בין בולדרינג להובלה בקיר טיפוס, איזה ציוד צריך, וכללי בטיחות והתנהגות. כולל קישור למפת קירות טיפוס בישראל."
  jsonLd={jsonLd}
>
  <section class="relative overflow-hidden border-b border-stone/40 py-10 sm:py-14">
    <TopoBackground opacity={0.3} />
    <div class="relative mx-auto max-w-4xl px-4 sm:px-6">
      <Badge variant="rope">Indoor</Badge>
      <h1 class="mt-3 font-display text-3xl font-bold text-ink sm:text-4xl">
        קיר טיפוס (מלאכותי)
      </h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-ink-soft">
        קיר מלאכותי הוא הדרך הכי נגישה, בטוחה ומבוקרת להתחיל לטפס - הסביבה
        קבועה, המסלולים מסומנים ומדורגים, ותמיד יש צוות בסביבה.
        רוב המטפסים בישראל מתחילים כאן.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-12">
    <h2 class="font-display text-2xl font-bold text-ink">
      שני הסגנונות בקיר טיפוס - וההבדל ביניהם
    </h2>
    <p class="mt-2 leading-relaxed text-ink-soft">
      כמעט כל קיר טיפוס בישראל מציע לפחות אחד משני הסגנונות האלה, ורבים מציעים
      את שניהם תחת קורת גג אחת:
    </p>

    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      <div class="border border-stone/50 bg-paper-dark p-5">
        <p class="font-display text-lg font-bold text-ink">
          בולדרינג בקיר טיפוס
        </p>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">
          קירות נמוכים (עד כ-4-5 מטרים) ללא חבלים, עם מזרנים עבים על
          הרצפה. <strong class="text-rust">לא צריך שותף, לא צריך הכשרה,
          ואין צורך בציוד אבטחה</strong> - נכנסים ומטפסים. זו סיבה מרכזית
          לכך שהוא נקודת הכניסה הכי פופולרית.
        </p>
        <a href={withBase("/סגנונות-טיפוס/bouldering/")} class="mt-3 inline-block font-body text-sm font-bold text-rope hover:underline">
          קראו עוד ←
        </a>
      </div>
      <div class="border border-stone/50 bg-paper-dark p-5">
        <p class="font-display text-lg font-bold text-ink">הובלה בקיר טיפוס</p>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">
          קירות גבוהים עם חבל, כשהמטפס מכניס את החבל לטבעות אבטחה תוך
          כדי הטיפוס. <strong class="text-rust">דורש שותף מאבטח (בליי)
          וקורס הסמכה</strong> - ברוב קירות הטיפוס לא יתנו לכם לטפס הובלה בלי
          תעודת הסמכה מוכרת, גם אם עשיתם את זה בעבר במקום אחר.
        </p>
        <a href={withBase("/סגנונות-טיפוס/lead-climbing/")} class="mt-3 inline-block font-body text-sm font-bold text-rope hover:underline">
          קראו עוד ←
        </a>
      </div>
    </div>
    <p class="mt-4 text-sm leading-relaxed text-ink-soft">
      בחלק מקירות הטיפוס מציעים גם <strong class="text-rust">טופ-רופ</strong> עם
      מערכת Auto-Belay - חבל שתלוי מראש ומאבטח אוטומטית, בלי צורך בשותף
      אנושי. בדקו מול קיר הטיפוס הספציפי מה הוא מציע, ואם נדרש תדרוך או
      מבחן אבטחה לפני טיפוס בטופ-רופ.
    </p>

    <SectionDivider class="my-10 text-stone/40" />

    <h2 class="font-display text-2xl font-bold text-ink">איזה ציוד צריך</h2>

    <div class="mt-5 space-y-5">
      <div>
        <p class="font-display font-bold text-ink">לבולדרינג בקיר טיפוס</p>
        <p class="mt-1 text-sm leading-relaxed text-ink-soft">
          כל קיר טיפוס משכיר{" "}
          <a href={withBase("/ציוד-טיפוס/climbing-shoes/")} class="font-bold text-rope hover:underline">נעלי טיפוס</a>{" "}
          ו<a href={withBase("/ציוד-טיפוס/chalk/")} class="font-bold text-rope hover:underline">מגנזיום</a>{" "}
          - אין צורך לקנות כלום מראש. אחרי כמה ביקורים, נעליים אישיות
          הן השדרוג הראשון ששווה לשקול.
        </p>
      </div>
      <div>
        <p class="font-display font-bold text-ink">להובלה בקיר טיפוס</p>
        <p class="mt-1 text-sm leading-relaxed text-ink-soft">
          בנוסף לנעליים ומגנזיום, תזדקקו ל-<a href={withBase("/ציוד-טיפוס/harness/")} class="font-bold text-rope hover:underline">רתמה</a>,{" "}
          <a href={withBase("/ציוד-טיפוס/belay-devices/")} class="font-bold text-rope hover:underline">מכשיר אבטחה</a>{" "}
          ו<a href={withBase("/ציוד-טיפוס/carabiners/")} class="font-bold text-rope hover:underline">טבעת ננעלת</a>.
          רוב קירות הטיפוס משכירים גם את אלה, ורק{" "}
          <a href={withBase("/ציוד-טיפוס/dynamic-rope/")} class="font-bold text-rope hover:underline">חבל דינמי</a>{" "}
          לפעמים נדרש להביא בעצמכם - תלוי במדיניות קיר הטיפוס.
        </p>
      </div>
    </div>

    <SectionDivider class="my-10 text-stone/40" />

    <h2 class="font-display text-2xl font-bold text-ink">
      בטיחות והתנהגות בקיר טיפוס
    </h2>
    <ul class="mt-4 space-y-2 text-ink">
      <li>
        <strong class="text-rust">אל תעמדו מתחת למטפס</strong> - גם בבולדרינג
        עם מזרנים, נפילה על מישהו שעומד מתחת מסוכנת לשניכם.
      </li>
      <li>
        <strong class="text-rust">השתמשו רק באחיזות המסומנות</strong> -
        מסלול מוגדר לפי צבע או תגית, וקפיצה בין מסלולים עלולה להוביל
        לתנועות לא צפויות.
      </li>
      <li>
        <strong class="text-rust">יורדים בשליטה, לא קופצים מגובה</strong> -
        אפילו ממזרן עבה, קפיצה מגובה רב מגדילה סיכון לפציעת קרסוליים.
      </li>
      <li>
        <strong class="text-rust">בהובלה - תמיד בדקו קשר ואבטחה כפולה</strong>{" "}
        לפני שמתחילים לטפס, גם אם אתם ושותף הבליי מנוסים.
      </li>
    </ul>

    <div class="mt-10 border border-dashed border-stone/60 bg-paper-dark p-5">
      <p class="font-display font-bold text-ink">איפה יש קיר טיפוס ליד הבית?</p>
      <p class="mt-2 text-sm leading-relaxed text-ink-soft">
        יש בישראל עשרות קירות מלאכותיים - מרשתות ארציות ועד מועדונים
        עצמאיים.
      </p>
      <a
        href={withBase("/מקומות-טיפוס/?kind=gym")}
        class="mt-3 inline-block font-body text-sm font-bold text-rope hover:underline"
      >
        לכל קירות הטיפוס בישראל ←
      </a>
    </div>

    <p class="mt-8 text-ink-soft">
      רוצים לדעת מה שונה כשיוצאים לסלע אמיתי?{" "}
      <a href={withBase("/טיפוס-בטבע/")} class="font-bold text-rope hover:underline">קראו על טיפוס בטבע ←</a>
    </p>
  </section>
</BaseLayout>
