---
import { withBase } from "../lib/url";
import { ENVIRONMENT_CARDS, GUIDE_CARDS, HISTORY_LINK } from "../lib/site-nav";
import { SITE_NAME, SITE_URL } from "../site-config";
import BaseLayout from "../layouts/BaseLayout.astro";
import TopoBackground from "../components/layout/TopoBackground.astro";
import RouteLine from "../components/ui/RouteLine.astro";
import GuideCardGrid from "../components/ui/GuideCardGrid.astro";
import UpcomingEvents from "../components/events/UpcomingEvents.astro";

const guides = GUIDE_CARDS;
const environments = ENVIRONMENT_CARDS;

const quickLocationLinks = [
  { href: "/מקומות-טיפוס/?kind=crag&style=bouldering", label: "בולדר בטבע" },
  { href: "/מקומות-טיפוס/?kind=crag&style=lead", label: "הובלה בטבע" },
  { href: "/מקומות-טיפוס/?kind=gym&style=bouldering", label: "בולדר בקיר טיפוס" },
  { href: "/מקומות-טיפוס/?kind=gym&style=lead", label: "הובלה בקיר טיפוס" },
  { href: "/מקומות-טיפוס/?kind=crag&guidebook=1", label: "אתרי טבע עם גיידבוק" },
];

const homeUrl = new URL(withBase("/"), SITE_URL).toString();
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE_NAME,
    url: homeUrl,
    description: "מדריך חינמי וקהילתי לטיפוס בישראל - בולדרינג וטיפוס בטבע.",
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: SITE_NAME,
    url: homeUrl,
    logo: new URL(withBase("/icons/icon-512.png"), SITE_URL).toString(),
  },
];
---

<BaseLayout
  title={`${SITE_NAME} - מדריך טיפוס ובולדרינג, קירות ואתרי טבע`}
  description="מדריך חינמי וקהילתי לטיפוס בישראל - בולדרינג וטיפוס בטבע. אחיזות, מושגים, ציוד ומפת קירות ואתרי טיפוס בכל הארץ."
  jsonLd={jsonLd}
>
  <section class="relative overflow-hidden border-b border-stone/40 py-8 sm:py-20">
    <TopoBackground class="text-contour" opacity={0.4} />
    <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6">
      <h1 class="font-display text-4xl font-bold text-ink sm:text-6xl">
        {SITE_NAME}
      </h1>
      <p class="mx-auto mt-3 max-w-xl text-lg leading-relaxed text-ink-soft sm:mt-4">
        {/* Phones: if the sentence doesn't fit on one line, it may only break
            between these two halves. */}
        <span class="whitespace-nowrap md:whitespace-normal">מאגר מידע קהילתי וחינמי</span>{" "}
        <span class="whitespace-nowrap md:whitespace-normal">לכל מי שרוצה לטפס.</span>{" "}
        {/* Phones get the first sentence only. */}
        <span class="hidden md:inline">
          בולדרינג בקיר או בטבע, טיפוס ספורטיבי, וטראד. מהאחיזה הראשונה ועד
          המצוק הבא.
        </span>
      </p>
      <div class="mx-auto mt-4 max-w-xs sm:mt-8">
        <RouteLine />
      </div>
      <div class="mt-4 flex flex-wrap items-center justify-center gap-4 sm:mt-8">
        <a
          href={withBase("/מדריך-למתחילים/")}
          class="border border-ink bg-ink px-5 py-2.5 font-body font-bold text-sm text-paper transition-colors hover:bg-rope hover:border-rope"
        >
          מדריך למתחילים
        </a>
        <a
          href={withBase("/מקומות-טיפוס/")}
          class="border border-dashed border-stone px-5 py-2.5 font-body font-bold text-sm text-ink transition-colors hover:border-rust hover:text-rust"
        >
          מצאו איפה לטפס
        </a>
      </div>
    </div>
  </section>

  <UpcomingEvents />

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <h2 class="font-display text-2xl font-bold text-ink">מפת הדרכים</h2>
    <p class="mt-2 max-w-2xl text-ink-soft">
      מהצעד הראשון על הקיר ועד תכנון היום הבא על סלע - כל המדריכים באתר.
    </p>

    <GuideCardGrid cards={guides} />
  </section>

  <section class="border-t border-stone/40 bg-paper-dark py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="font-display text-2xl font-bold text-ink">מקומות טיפוס</h2>
      <p class="mt-2 max-w-2xl text-ink-soft">
        עשרות קירות מלאכותיים ואתרי טבע ברחבי הארץ - חפשו לפי סגנון, סביבה
        או עיר.
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        {
          quickLocationLinks.map((link) => (
            <a
              href={withBase(link.href)}
              class="border border-dashed border-stone px-4 py-2 font-body text-sm font-bold text-ink transition-colors hover:border-rust hover:text-rust"
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <a
        href={withBase("/מקומות-טיפוס/")}
        class="mt-3 inline-block py-2 font-body text-sm font-bold text-rope hover:underline"
      >
        לכל מקומות הטיפוס ←
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <h2 class="font-display text-2xl font-bold text-ink">סביבות טיפוס</h2>
    <p class="mt-2 max-w-2xl text-ink-soft">
      אותם סגנונות מרגישים אחרת לגמרי בקיר מלאכותי לעומת סלע טבעי - הנה
      מה שונה בכל אחד.
    </p>

    <GuideCardGrid cards={environments} columns="" />
  </section>

  <section class="border-t border-stone/40 bg-paper-dark py-12 sm:py-16">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <h2 class="font-display text-2xl font-bold text-ink">
        פרויקט קהילתי, בהתנדבות
      </h2>
      <p class="mt-3 leading-relaxed text-ink-soft">
        טיפוס ישראל נבנה כמאגר מידע פתוח וחינמי - בלי פרסומות, בלי הרשמה.
      </p>
      <div class="mt-5 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        <a
          href={withBase("/אודות/")}
          class="inline-block py-2 font-body text-sm font-bold text-rope hover:underline"
        >
          עוד על הפרויקט ←
        </a>
        <a
          href={withBase(HISTORY_LINK.href)}
          class="inline-block py-2 font-body text-sm font-bold text-rope hover:underline"
        >
          {HISTORY_LINK.label} ←
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
