---
import { withBase } from "../../lib/url";
import { getCollection, render } from "astro:content";
import GuideLayout from "../../layouts/GuideLayout.astro";
import Badge from "../../components/ui/Badge.astro";

export async function getStaticPaths() {
  const entries = await getCollection("injury-prevention");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const categoryLabels: Record<string, string> = {
  "warmup-prep": "חימום והכנה",
  "common-injuries": "פציעות נפוצות ומניעתן",
  "recovery-training": "התאוששות ואימון מונע",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: `${entry.data.nameHe} (${entry.data.nameEn})`,
  description: entry.data.summary,
  articleSection: categoryLabels[entry.data.category],
};
---

<GuideLayout
  title={`${entry.data.nameHe} (${entry.data.nameEn}) - מניעת פציעות בטיפוס`}
  description={entry.data.summary}
  breadcrumbs={[
    { href: "/", label: "בית" },
    { href: "/מניעת-פציעות/", label: "מניעת פציעות" },
    { href: `/מניעת-פציעות/${entry.id}/`, label: entry.data.nameHe },
  ]}
  jsonLd={jsonLd}
>
  <Badge variant="olive">{categoryLabels[entry.data.category]}</Badge>
  <h1 class="mt-3 font-display text-3xl font-bold text-ink">
    {entry.data.nameHe}
  </h1>
  <p class="mt-1 font-mono text-sm text-ink-soft">{entry.data.nameEn}</p>

  <div class="prose-climbing mt-8 max-w-none leading-relaxed text-ink">
    <Content />
  </div>

  <a
    href={withBase("/מניעת-פציעות/")}
    class="mt-10 inline-block font-body text-sm font-bold text-rope hover:underline"
  >
    → חזרה למניעת פציעות
  </a>
</GuideLayout>
