---
import { withBase } from "../../lib/url";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopoBackground from "../../components/layout/TopoBackground.astro";
import LocationCard from "../../components/directory/LocationCard.astro";
import LocationTable from "../../components/directory/LocationTable.astro";
import DirectoryFilters from "../../components/directory/DirectoryFilters";
import LocationMap from "../../components/directory/LocationMap";
import { publiclyVisibleLocations } from "../../lib/locations";

const locations = publiclyVisibleLocations(await getCollection("locations"));
const gymCount = locations.filter((l) => l.data.kind === "gym").length;
const cragCount = locations.filter((l) => l.data.kind === "crag").length;

const sorted = [...locations].sort((a, b) =>
  a.data.name.localeCompare(b.data.name, "he"),
);

const mapLocations = sorted
  .filter((l) => l.data.coordinates)
  .map((l) => ({
    id: l.id,
    kind: l.data.kind,
    name: l.data.name,
    region: l.data.region,
    city: l.data.kind === "gym" ? l.data.city : undefined,
    lat: l.data.coordinates!.lat,
    lng: l.data.coordinates!.lng,
  }));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "מקומות טיפוס בישראל",
  numberOfItems: locations.length,
};
---

<BaseLayout
  title="מקומות טיפוס בישראל - קירות מלאכותיים ואתרי טבע"
  description={`מדריך לכל מקומות הטיפוס בישראל: ${gymCount} קירות טיפוס מלאכותיים ו-${cragCount} אתרי טיפוס בטבע, לפי עיר, אזור וסגנון.`}
  jsonLd={jsonLd}
>
  <section class="relative overflow-hidden border-b border-stone/40 py-14">
    <TopoBackground opacity={0.3} />
    <div class="relative mx-auto max-w-4xl px-4 sm:px-6">
      <h1 class="font-display text-3xl font-bold text-ink sm:text-4xl">
        מקומות טיפוס בישראל
      </h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-ink-soft">
        {gymCount} קירות טיפוס מלאכותיים ו-{cragCount} אתרי טיפוס בטבע, מהצפון
        ועד הערבה.
      </p>
      <p class="mt-3 max-w-2xl leading-relaxed text-ink-soft">
        המידע נאסף בהתנדבות - כדאי לוודא שעות פתיחה ותנאים מול המקום לפני
        יציאה.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <DirectoryFilters client:load />

    <ul id="location-cards-view" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {sorted.map((location) => <LocationCard location={location} />)}
    </ul>

    <div id="location-table-view" class="hidden mt-6">
      <LocationTable locations={sorted} />
    </div>

    <div id="location-map-view" class="hidden mt-6">
      <LocationMap client:load locations={mapLocations} />
    </div>

    <div id="crag-guidebook-note" class="hidden mt-8 space-y-3 border-t border-dashed border-stone/50 pt-6 text-xs leading-relaxed text-ink-soft">
      <p>
        לחלק מהאתרים עדיין אין מדריך טיפוס (guidebook) מפורט באתר. יש לכם
        מידע, תמונות מסלולים או קובץ טופו שתרצו לשתף?{" "}
        <a href={withBase("/אודות/")} class="font-bold text-rope hover:underline">
          נשמח שתעזרו לנו לעדכן
        </a>
        .
      </p>
      <p>
        נעזרנו במידע מהאתרים הבאים:{" "}
        <a
          href="https://ilca.org.il/rock-3/%D7%90%D7%AA%D7%A8%D7%99-%D7%98%D7%99%D7%A4%D7%95%D7%A1/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold text-rope hover:underline"
        >
          התאחדות הטיפוס בישראל (ILCA)
        </a>
        ,{" "}
        <a
          href="https://wiki.imga.org.il/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold text-rope hover:underline"
        >
          אנציקלופדיית הטיפוס
        </a>{" "}
        ו
        <a
          href="https://he.wikipedia.org/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold text-rope hover:underline"
        >
          ויקיפדיה
        </a>
        .
      </p>
    </div>
  </section>
</BaseLayout>
