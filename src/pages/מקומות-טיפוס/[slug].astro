---
import { withBase, withBaseIfRelative } from "../../lib/url";
import { getCollection, render } from "astro:content";
import GuideLayout from "../../layouts/GuideLayout.astro";
import Badge from "../../components/ui/Badge.astro";
import NavigationButtons from "../../components/directory/NavigationButtons.astro";
import {
  locationNavTarget,
  publiclyVisibleLocations,
  sortByName,
} from "../../lib/locations";
import { REGION_LABELS, STYLE_LABELS } from "../../lib/labels";
import { SITE_URL } from "../../site-config";

export async function getStaticPaths() {
  const locations = publiclyVisibleLocations(await getCollection("locations"));
  return locations.map((location) => ({
    params: { slug: location.id },
    props: { location },
  }));
}

const { location } = Astro.props;
const { data } = location;
const { Content } = await render(location);

const navTarget = locationNavTarget(location);
const pageUrl = new URL(withBase(`/מקומות-טיפוס/${location.id}/`), SITE_URL).toString();

const NO_INFO = "אין מידע";

const cragSpecs =
  data.kind === "crag"
    ? [
        { label: "סלע", value: data.rockType },
        { label: "אורך המסלולים", value: data.routeLength },
        { label: "כמות מסלולים", value: data.routeCount },
        { label: "עונה", value: data.season },
        { label: "צל", value: data.shade },
        { label: "לינה", value: data.lodging },
      ]
    : [];

const gymSpecs =
  data.kind === "gym"
    ? [
        {
          label: "שעות פתיחה",
          value: data.hours
            ? Object.entries(data.hours)
                .map(([day, h]) => `${day}: ${h}`)
                .join(" · ")
            : undefined,
        },
      ]
    : [];

const chainBranches =
  data.kind === "gym" && data.chain
    ? sortByName(
        publiclyVisibleLocations(await getCollection("locations")).filter(
          (l) => l.data.kind === "gym" && l.data.chain === data.chain && l.id !== location.id,
        ),
      )
    : [];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SportsActivityLocation",
  name: data.name,
  url: pageUrl,
  ...(data.description ? { description: data.description } : {}),
  ...(data.coordinates
    ? {
        geo: {
          "@type": "GeoCoordinates",
          latitude: data.coordinates.lat,
          longitude: data.coordinates.lng,
        },
      }
    : {}),
  ...(data.kind === "gym"
    ? {
        address: {
          "@type": "PostalAddress",
          ...(data.address ? { streetAddress: data.address } : {}),
          addressLocality: data.city,
          addressCountry: "IL",
        },
        ...(data.phone ? { telephone: data.phone } : {}),
        ...(data.website ? { sameAs: data.website } : {}),
      }
    : {
        address: { "@type": "PostalAddress", addressCountry: "IL" },
        isAccessibleForFree: true,
      }),
};
---

<GuideLayout
  title={`${data.name} - ${data.kind === "gym" ? "קיר טיפוס" : "אתר טיפוס בטבע"}`}
  description={
    data.description ??
    `${data.name} - ${data.kind === "gym" ? `קיר טיפוס ב${data.city}` : `אתר טיפוס בטבע באזור ${REGION_LABELS[data.region]}`}.`
  }
  breadcrumbs={[
    { href: "/", label: "בית" },
    { href: "/מקומות-טיפוס/", label: "מקומות טיפוס" },
    { href: `/מקומות-טיפוס/${location.id}/`, label: data.name },
  ]}
  jsonLd={jsonLd}
  ogType="website"
>
  <Badge variant={data.kind === "gym" ? "rope" : "olive"}>
    {data.kind === "gym" ? "קיר טיפוס" : "אתר טבע"}
  </Badge>
  <h1 class="mt-3 font-display text-3xl font-bold text-ink">{data.name}</h1>
  <p class="mt-1 text-sm text-ink-soft">
    {REGION_LABELS[data.region]}
    {data.kind === "gym" && data.chain ? ` · רשת ${data.chain}` : ""}
  </p>

  {
    data.kind === "gym" && (
      <div class="mt-8 space-y-6">
        <div>
          <h2 class="font-body text-sm font-bold text-ink-soft">תיאור קיר הטיפוס</h2>
          <div class="prose-climbing mt-2 max-w-none leading-relaxed text-ink">
            <Content />
          </div>
        </div>

        <div>
          <h2 class="font-body text-sm font-bold text-ink-soft">מיקום</h2>
          <p class="mt-2 text-sm leading-relaxed text-ink">
            {[data.city, data.address].filter(Boolean).join(", ") || NO_INFO}
          </p>
          <NavigationButtons target={navTarget} placeName={data.name} size="sm" class="mt-3" />
        </div>

        <div>
          <h2 class="font-body text-sm font-bold text-ink-soft">סגנון</h2>
          <div class="mt-2 flex flex-wrap gap-1.5">
            {data.styles.map((s: string) => <Badge variant="stone">{STYLE_LABELS[s]}</Badge>)}
          </div>
        </div>

        {
          gymSpecs.map((spec) => (
            <div>
              <h2 class="font-body text-sm font-bold text-ink-soft">{spec.label}</h2>
              <p class="mt-2 text-sm leading-relaxed text-ink">{spec.value || NO_INFO}</p>
            </div>
          ))
        }

        <div>
          <h2 class="font-body text-sm font-bold text-ink-soft">טלפון</h2>
          {
            data.phone ? (
              <a
                href={`tel:${data.phone.replace(/[^0-9+]/g, "")}`}
                class="mt-2 inline-block font-body text-sm font-bold text-ink hover:text-rust"
                dir="ltr"
              >
                {data.phone}
              </a>
            ) : (
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{NO_INFO}.</p>
            )
          }
        </div>

        <div>
          <h2 class="font-body text-sm font-bold text-ink-soft">אתר קיר הטיפוס</h2>
          {
            data.website ? (
              <a
                href={data.website}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-2 inline-block font-body text-sm font-bold text-rope hover:underline"
              >
                לאתר קיר הטיפוס ←
              </a>
            ) : (
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                אין אתר זמין כרגע.
              </p>
            )
          }
        </div>

        {
          chainBranches.length > 0 && (
            <div>
              <h2 class="font-body text-sm font-bold text-ink-soft">
                סניפים נוספים ברשת {data.chain}
              </h2>
              <p class="mt-2 text-sm leading-relaxed">
                {chainBranches.map((branch, i) => (
                  <Fragment>
                    <a
                      href={withBase(`/מקומות-טיפוס/${branch.id}/`)}
                      class="font-body font-bold text-ink hover:text-rust"
                    >
                      {branch.data.name}
                    </a>
                    {i < chainBranches.length - 1 ? ", " : ""}
                  </Fragment>
                ))}
              </p>
            </div>
          )
        }
      </div>
    )
  }

  {
    data.kind === "crag" && (
      <div class="mt-8 space-y-6">
        <div>
          <h2 class="font-body text-sm font-bold text-ink-soft">תיאור המצוק</h2>
          <div class="prose-climbing mt-2 max-w-none leading-relaxed text-ink">
            <Content />
          </div>
        </div>

        <div>
          <h2 class="font-body text-sm font-bold text-ink-soft">מיקום</h2>
          <p class="mt-2 text-sm leading-relaxed text-ink">
            {data.locationDescription ?? NO_INFO}
          </p>
          {
            data.accessDescription && (
              <p class="mt-3 text-sm leading-relaxed text-ink">
                <span class="font-body text-xs font-bold text-ink-soft">דרכי הגעה: </span>
                {data.accessDescription}
              </p>
            )
          }
          <NavigationButtons target={navTarget} placeName={data.name} size="sm" class="mt-3" />
        </div>

        <div>
          <h2 class="font-body text-sm font-bold text-ink-soft">סגנון</h2>
          <div class="mt-2 flex flex-wrap gap-1.5">
            {data.styles.map((s: string) => <Badge variant="stone">{STYLE_LABELS[s]}</Badge>)}
          </div>
        </div>

        {
          cragSpecs.map((spec) => (
            <div>
              <h2 class="font-body text-sm font-bold text-ink-soft">{spec.label}</h2>
              <p class="mt-2 text-sm leading-relaxed text-ink">{spec.value || NO_INFO}</p>
            </div>
          ))
        }

        <div>
          <h2 class="font-body text-sm font-bold text-ink-soft">עוד על המצוק</h2>
          {
            data.externalBetaUrl ? (
              <a
                href={data.externalBetaUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-2 inline-block font-body text-sm font-bold text-rope hover:underline"
              >
                לקריאה נוספת ←
              </a>
            ) : (
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                אין מידע נוסף זמין כרגע.
              </p>
            )
          }
        </div>

        <div>
          <h2 class="font-body text-sm font-bold text-ink-soft">להורדת הגיידבוק</h2>
          {
            data.guidebooks && data.guidebooks.length > 0 ? (
              <ul class="mt-2 space-y-1.5">
                {data.guidebooks.map((g: { label: string; url: string }) => (
                  <li>
                    <a
                      href={withBaseIfRelative(g.url)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-block font-body text-sm font-bold text-rope hover:underline"
                    >
                      {g.label}
                      {g.url.toLowerCase().endsWith(".pdf") && (
                        <span class="font-normal text-ink-soft"> (PDF)</span>
                      )}{" "}
                      ←
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                אין גיידבוק זמין להורדה כרגע.
              </p>
            )
          }
          {
            data.guidebooks && data.guidebooks.length > 0 && (
              <p class="mt-2 text-xs leading-relaxed text-ink-soft">
                כל הזכויות בגיידבוקים ובקבצי הטופו שמורות ליוצריהם.
              </p>
            )
          }
        </div>
      </div>
    )
  }

  {
    data.sourceNote && (
      <div class="mt-8 border border-dashed border-stone/60 bg-paper-dark p-4 text-sm leading-relaxed text-ink-soft">
        ⚠ {data.sourceNote}
      </div>
    )
  }

  <a
    href={withBase("/מקומות-טיפוס/")}
    class="mt-10 inline-block font-body text-sm font-bold text-rope hover:underline"
  >
    → חזרה לכל המקומות
  </a>
</GuideLayout>
