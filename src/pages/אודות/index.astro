---
import { withBase } from "../../lib/url";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopoBackground from "../../components/layout/TopoBackground.astro";
import SectionDivider from "../../components/ui/SectionDivider.astro";
import ThemeSwitcher from "../../components/settings/ThemeSwitcher";
---

<BaseLayout
  title="אודות הפרויקט"
  description="טיפוס ישראל הוא מאגר מידע חינמי וקהילתי לטיפוס בישראל - בולדרינג וטיפוס בטבע. איך נבנה האתר ולמה."
>
  <section class="relative border-b border-stone/40 py-14">
    <div class="absolute inset-0 overflow-hidden">
      <TopoBackground opacity={0.3} />
    </div>
    <div class="relative mx-auto flex max-w-4xl items-start justify-between gap-4 px-4 sm:px-6">
      <h1 class="font-display text-3xl font-bold text-ink sm:text-4xl">
        אודות טיפוס ישראל
      </h1>
      <ThemeSwitcher client:load />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <div class="space-y-6 leading-relaxed text-ink">
      <p>
        <strong class="text-rust">טיפוס ישראל</strong> נבנה כמאגר מידע פתוח
        וחינמי לכל מי שרוצה לטפס בישראל - בין אם מדובר בבולדרינג בקיר סגור,
        בולדרינג בטבע, או טיפוס ספורטיבי וטראד על סלע. האתר לא נועד להחליף
        הדרכה מקצועית, אלא לרכז במקום אחד את השפה, המושגים והמידע הבסיסי
        שכל מטפס - ממתחיל ועד מתקדם - נתקל בו.
      </p>

      <p>
        לא בטוחים איפה להתחיל? <a href={withBase("/מדריך-למתחילים/")} class="font-bold text-rope hover:underline">מדריך למתחילים</a>{" "}
        הוא נקודת הפתיחה הטובה ביותר. משם אפשר להעמיק ב-
        <a href={withBase("/אחיזות-טיפוס/")} class="font-bold text-rope hover:underline">אחיזות טיפוס</a>,{" "}
        <a href={withBase("/מושגי-טיפוס/")} class="font-bold text-rope hover:underline">מושגי טיפוס</a>,{" "}
        <a href={withBase("/דירוג-מסלולים/")} class="font-bold text-rope hover:underline">דירוג מסלולים</a>,{" "}
        <a href={withBase("/סגנונות-טיפוס/")} class="font-bold text-rope hover:underline">סגנונות טיפוס</a> ו-<a href={withBase("/ציוד-טיפוס/")} class="font-bold text-rope hover:underline">ציוד טיפוס</a>,{" "}
        לקרוא על ההבדל בין{" "}
        <a href={withBase("/טיפוס-באולם/")} class="font-bold text-rope hover:underline">טיפוס באולם</a>{" "}
        ל-<a href={withBase("/טיפוס-בטבע/")} class="font-bold text-rope hover:underline">טיפוס בטבע</a>,{" "}
        ולמצוא קיר או אתר ב-<a href={withBase("/מקומות-טיפוס/")} class="font-bold text-rope hover:underline">מדריך המקומות</a>.
      </p>

      <p>
        סקרנים מאיפה כל זה התחיל? קראו על{" "}
        <a href={withBase("/היסטוריית-הטיפוס-בישראל/")} class="font-bold text-rope hover:underline">היסטוריית הטיפוס בישראל</a>{" "}
        - ממועדון אלפיני קטן ב-1939 ועד התאחדות הטיפוס הישראלית של היום.
      </p>

      <SectionDivider class="text-stone/40" />

      <h2 class="font-display text-xl font-bold text-ink">דיוק המידע</h2>
      <p>
        המידע באתר נאסף בהתנדבות ובקפידה, אך עולם הטיפוס משתנה - אולמות
        סוגרים ונפתחים, שעות פתיחה ומחירים מתעדכנים, ותנאי שטח (במיוחד בטבע)
        יכולים להשתנות בעקבות מזג אוויר או עונה. לפני יציאה לטיפוס, במיוחד
        בטבע, מומלץ תמיד לוודא מידע עדכני מול המקום או עם מטפסים מנוסים
        באזור, ולא להסתמך על האתר כמקור בטיחותי בלעדי.
      </p>

      <p>
        טיפוס - במיוחד בטבע וללא ציוד אבטחה מלא - כרוך בסיכון ממשי. האתר
        אינו תחליף להדרכה מקצועית, ואינו אחראי לשימוש שנעשה במידע המופיע בו.
      </p>

      <h2 class="font-display text-xl font-bold text-ink">רוצים לעזור?</h2>
      <p>
        נתקלתם במידע לא מדויק, אולם שנסגר, או אתר טיפוס שחסר באתר? נשמח
        לעדכן - הפרויקט קהילתי ופתוח לתיקונים ותוספות.
      </p>

      <h2 class="font-display text-xl font-bold text-ink">תודות</h2>
      <p>
        רוב המידע על אולמות ואתרי טיפוס בטבע באתר מבוסס על{" "}
        <a
          href="https://ilca.org.il/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold text-rope hover:underline"
        >
          התאחדות הטיפוס בישראל (ILCA)
        </a>{" "}
        ועל{" "}
        <a
          href="https://wiki.imga.org.il/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold text-rope hover:underline"
        >
          האנציקלופדיה של הטיפוס (wiki.imga.org.il)
        </a>
        , בתוספת עדכונים קהילתיים. תודה גם למדריך הטיפוס המודפס{" "}
        <a
          href="https://www.climbing-israel.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold text-rope hover:underline"
        >
          The Israeli Climbing Guidebook
        </a>{" "}
        ולחברת{" "}
        <a
          href="https://www.vfisrael.co.il/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold text-rope hover:underline"
        >
          ויה פראטה ישראל
        </a>
        . בלי העבודה שכל הגורמים האלו השקיעו בתיעוד סצנת הטיפוס בישראל, האתר
        הזה פשוט לא היה יכול להתקיים.
      </p>
    </div>
  </section>
</BaseLayout>
