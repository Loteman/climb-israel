---
import { withBase } from "../../lib/url";
import { getCollection, render } from "astro:content";
import GuideLayout from "../../layouts/GuideLayout.astro";
import Badge from "../../components/ui/Badge.astro";

export async function getStaticPaths() {
  const terms = await getCollection(
    "glossary",
    (t) => t.data.category !== "discipline-style",
  );
  return terms.map((term) => ({
    params: { slug: term.id },
    props: { term },
  }));
}

const { term } = Astro.props;
const { Content } = await render(term);

const categoryLabels: Record<string, string> = {
  "movement-technique": "תנועה וטכניקה על הקיר",
  "sending-attempts": "הצלחה, ניסיונות ומהלך הטיפוס",
  "wall-safety": "מושגי מבנה קיר ובטיחות",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  name: `${term.data.termHe} (${term.data.termEn})`,
  description: term.data.summary,
};
---

<GuideLayout
  title={`${term.data.termHe} (${term.data.termEn}) - מושג טיפוס`}
  description={term.data.summary}
  breadcrumbs={[
    { href: "/", label: "בית" },
    { href: "/מושגי-טיפוס/", label: "מושגי טיפוס" },
    { href: `/מושגי-טיפוס/${term.id}/`, label: term.data.termHe },
  ]}
  jsonLd={jsonLd}
>
  <Badge variant="olive">{categoryLabels[term.data.category]}</Badge>
  <h1 class="mt-3 font-display text-3xl font-bold text-ink">
    {term.data.termHe}
  </h1>
  <p class="mt-1 font-mono text-sm text-ink-soft">{term.data.termEn}</p>

  <div class="prose-climbing mt-8 max-w-none leading-relaxed text-ink">
    <Content />
  </div>

  <a
    href={withBase("/מושגי-טיפוס/")}
    class="mt-10 inline-block font-body text-sm font-bold text-rope hover:underline"
  >
    → חזרה לכל המושגים
  </a>
</GuideLayout>
