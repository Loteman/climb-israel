---
import { withBase } from "../../lib/url";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopoBackground from "../../components/layout/TopoBackground.astro";
import SectionDivider from "../../components/ui/SectionDivider.astro";

// Every fact below is taken from the two sources cited at the bottom of
// the page (Hebrew Wikipedia + the IMGA climbing wiki). Where they
// disagree, the page says so instead of picking one.
const description =
  "מ-1939 ועד היום: איך התחיל הטיפוס המאורגן בישראל - ממועדון אלפיני של חובבי סקי, דרך מועדון המטפסים הישראלי, ועד התאחדות הטיפוס בישראל (ILCA) של היום.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "היסטוריית הטיפוס בישראל",
  description,
};

const linkClass = "font-bold text-rope hover:underline";
const crag = (slug: string) => withBase(`/מקומות-טיפוס/${slug}/`);
---

<BaseLayout title="היסטוריית הטיפוס בישראל" description={description} jsonLd={jsonLd} ogType="article">
  <section class="relative overflow-hidden border-b border-stone/40 py-10 sm:py-14">
    <TopoBackground opacity={0.3} />
    <div class="relative mx-auto max-w-4xl px-4 sm:px-6">
      <h1 class="font-display text-3xl font-bold text-ink sm:text-4xl">
        היסטוריית הטיפוס בישראל
      </h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-ink-soft">
        כמעט 90 שנה לפני שהיה כאן אתר כמו זה, כבר היו בישראל אנשים שטיפסו על
        סלע. הנה איך זה התחיל.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="space-y-6 leading-relaxed text-ink">
      <h2 class="font-display text-xl font-bold text-ink">1939: מסקי לסלע</h2>
      <p>
        הארגון שמאחורי הטיפוס המאורגן בישראל הוקם ב-1939, ונקרא במקור{" "}
        <strong class="text-rust">"המועדון האלפיני הארץ-ישראלי"</strong>. את
        המועדון ייסד <strong class="text-rust">משה (מוסא) חבצלת</strong>{" "}
        (1904–1981), שהיה גם נשיאו הראשון.
      </p>
      <p>
        חבריו הראשונים היו בעיקר עולים ממרכז אירופה שביקשו להקים מועדון סקי -
        אלא שבארץ ישראל אין אתרי סקי. במקום זאת הם פנו לטיפוס אלפיני, שבתורו
        התפתח לטיפוס סלע כפי שהוא מוכר היום.
      </p>
      <p>
        חבצלת עצמו נולד בצפת וטיפס על סלעים מילדותו. בשנות ה-20, כשנסע ללמוד
        בצרפת (אחרי שסיים את גימנסיה רחביה באחד המחזורים הראשונים שלה), הצטרף
        למועדון האלפיני הצרפתי והתמקצע גם בטיפוס אלפיני. אחרי מלחמת העולם
        השנייה חזר לנסוע לאלפים לטפס מדי שנה, והיה חבר בכמה מועדונים
        אלפיניים.
      </p>
      <p>
        פרט סקרן מהתקופה: לפי ויקיפדיה ולפי אחת הגרסאות באנציקלופדיה של
        הטיפוס, <strong class="text-rust">האמיר עבדאללה</strong> (סבו של המלך
        חוסיין, וסבא-רבא של המלך עבדאללה השני של ירדן) היה חבר במועדון.
        בתו של חבצלת סיפרה גרסה אחרת: האמיר לא היה חבר במועדון, אבל טיפס עם
        חבצלת בהרי יהודה אחרי מלחמת העולם הראשונה, לאחר שהמשפחה עברה
        לירושלים.
      </p>

      <SectionDivider class="text-stone/40" />

      <h2 class="font-display text-xl font-bold text-ink">
        מהחרמון לאלפים - גרסה נוספת
      </h2>
      <p>
        בתו של חבצלת תיארה גם את ההקמה עצמה אחרת: לפי גרסתה,{" "}
        <strong class="text-rust">אחרי כיבוש החרמון ב-1967</strong> והטיולים
        באזור, ישראלים רבים יותר התחילו להימשך גם לאלפים. אחרי שתיים-שלוש
        תאונות קטלניות של מטיילים ישראלים באלפים, שנגרמו מחוסר מודעות לסכנות,
        החליט חבצלת להקים את המועדון. סביבו התקבצה קבוצת מטפסים, שכללה גם בני
        משפחה, והאימונים נערכו ב
        <a href={crag("gei-ben-hinnom-cliff")} class={linkClass}>גיא בן הינום</a>{" "}
        ובכמה מקומות בכרמל.
      </p>
      <p>
        הגרסה הזו לא מתיישבת עם שנת ההקמה 1939 שמופיעה בשאר המקורות - והמקור
        עצמו מציין את הסתירה. השארנו את שתיהן.
      </p>

      <SectionDivider class="text-stone/40" />

      <h2 class="font-display text-xl font-bold text-ink">
        עמותה, ואתרים חדשים לטיפוס
      </h2>
      <p>
        ב-<strong class="text-rust">1987</strong> המועדון נרשם כעמותה ללא כוונת
        רווח. מטרותיו: להרחיב את חוג המטפסים ואת אתרי הטיפוס בישראל, תוך
        הנחלת ערכי טבע ושמירה עליו, מקצועיות ובטיחות.
      </p>
      <p>
        שנות ה-2000 היו תקופת פיתוח משמעותית. ב-2004–2005 נפתחו{" "}
        <a href={crag("znoach-cliff")} class={linkClass}>מצוק זנוח</a> ו
        <a href={crag("yonim-cliff")} class={linkClass}>מצוק היונים</a>, ונוספו
        מסלולים רבים ב
        <a href={crag("gita-cliff")} class={linkClass}>גיתה</a>. ב-2005, אחרי
        מגעים עם רשות הטבע והגנים, אושר לטיפוס חלק מהצוק הדרומי ב
        <a href={crag("ein-fara")} class={linkClass}>עין פרת</a>. ב-2007 בוצעה
        תחזוקה מלאה של{" "}
        <a href={crag("beit-arye-cliff")} class={linkClass}>אתר בית אריה</a> ונפתח
        החלק המערבי של מצוק גיתה, וב-2008 נוספו מסלולים רבים ברכס רמים. רבים
        מהאתרים האלה מופיעים היום ב
        <a href={withBase("/מקומות-טיפוס/?kind=crag")} class={linkClass}>
          מדריך אתרי הטבע
        </a>{" "}
        של האתר הזה.
      </p>
      <p>
        המועדון גם הוסמך על ידי רשות הטבע והגנים, באופן בלעדי, להסמיך מבלטים
        ולבלט אתרי טיפוס שנמצאים בשמורות טבע.
      </p>

      <SectionDivider class="text-stone/40" />

      <h2 class="font-display text-xl font-bold text-ink">מהמועדון להתאחדות</h2>
      <p>
        ב-<strong class="text-rust">2011</strong> שונה שם הארגון ל"מועדון
        המטפסים הישראלי", כדי לפנות לכל המטפסים בישראל - ובעיקר למטפסים
        ספורטיביים ולמטפסי קירות, שהם רוב המטפסים בארץ - ולא רק למי שמגדירים
        את עצמם מטפסים אלפיניים. המטרות עצמן לא השתנו.
      </p>
      <p>
        ב-<strong class="text-rust">2018</strong> התקבל המועדון כגוף המייצג את
        כל ענפי ספורט הטיפוס בישראל - ספורטיבי, תחרותי ואלפיני - במקום
        האיגוד הישראלי לטיפוס ספורטיבי (איט"ס), ומאז הוא אחראי גם על ליגת
        התחרויות, על נבחרת ישראל ועל ההשתתפות בתחרויות בינלאומיות. באותה שנה
        גם החליט המועדון להעסיק לראשונה מנכ"ל בתשלום.
      </p>
      <p>
        בעקבות ההכרה הזו שונה השם שוב ב-<strong class="text-rust">2019</strong>,
        ל
        <strong class="text-rust">
          התאחדות הטיפוס הספורטיבי והאתגרי בישראל
        </strong>{" "}
        - המוכרת בקיצור כ"התאחדות הטיפוס בישראל" (ILCA), ומקור עיקרי למידע
        באתר הזה.
      </p>
      <p>
        ההתאחדות מוכרת על ידי מינהל הספורט כגוף היציג של ספורט הטיפוס, והיא
        חברה בפדרציה הבינלאומית לטיפוס ספורטיבי (IFSC) ובפדרציה הבינלאומית
        לטיפוס ולטיפוס הרים (UIAA). זה הגוף היחיד בישראל שמפיק את אליפויות
        ישראל ושולח מטפסים לתחרויות בינלאומיות. לצד זה היא ממשיכה את העבודה
        שהמועדון האלפיני התחיל: פיתוח אתרים ומסלולים חדשים, שיפור הבטיחות,
        תחזוקת אתרים כמו{" "}
        <a href={crag("shilat-cliff")} class={linkClass}>שילת</a>, בית אריה,
        גיתה ורכס רמים, תמיכה במשלחות טיפוס, וקורסים והרצאות.
      </p>

      <SectionDivider class="text-stone/40" />

      <p class="text-sm text-ink-soft">
        הערך מבוסס על{" "}
        <a
          href="https://he.wikipedia.org/wiki/%D7%94%D7%AA%D7%90%D7%97%D7%93%D7%95%D7%AA_%D7%94%D7%98%D7%99%D7%A4%D7%95%D7%A1_%D7%94%D7%A1%D7%A4%D7%95%D7%A8%D7%98%D7%99%D7%91%D7%99_%D7%95%D7%94%D7%90%D7%AA%D7%92%D7%A8%D7%99_%D7%91%D7%99%D7%A9%D7%A8%D7%90%D7%9C"
          target="_blank"
          rel="noopener noreferrer"
          class={linkClass}
        >
          ערך ההתאחדות בוויקיפדיה
        </a>{" "}
        ועל{" "}
        <a
          href="https://wiki.imga.org.il/index.php?title=%D7%94%D7%9E%D7%95%D7%A2%D7%93%D7%95%D7%9F_%D7%94%D7%90%D7%9C%D7%A4%D7%99%D7%A0%D7%99"
          target="_blank"
          rel="noopener noreferrer"
          class={linkClass}
        >
          ערך "המועדון האלפיני" באנציקלופדיה של הטיפוס
        </a>. המקורות חלוקים בעיקר בסיפור ההקמה (1939, או לאחר 1967 לפי גרסת בתו
        של חבצלת) ובשאלה אם האמיר עבדאללה היה חבר במועדון - שתי הגרסאות
        מובאות למעלה בכוונה, ולא הוכרעו באופן שרירותי.
      </p>
    </div>
  </section>
</BaseLayout>
