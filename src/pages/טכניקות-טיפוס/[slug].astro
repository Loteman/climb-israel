---
import { getCollection, render } from "astro:content";
import GuideLayout from "../../layouts/GuideLayout.astro";
import Badge from "../../components/ui/Badge.astro";

export async function getStaticPaths() {
  const techniques = await getCollection("techniques");
  return techniques.map((technique) => ({
    params: { slug: technique.id },
    props: { technique },
  }));
}

const { technique } = Astro.props;
const { Content } = await render(technique);

const categoryLabels: Record<string, string> = {
  fundamentals: "יסודות התנועה",
  "advanced-movement": "טכניקות תנועה מתקדמות",
  "effort-safety": "ניהול מאמץ ובטיחות",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: `${technique.data.nameHe} (${technique.data.nameEn})`,
  description: technique.data.summary,
  articleSection: categoryLabels[technique.data.category],
};
---

<GuideLayout
  title={`${technique.data.nameHe} (${technique.data.nameEn}) - טכניקת טיפוס`}
  description={technique.data.summary}
  breadcrumbs={[
    { href: "/", label: "בית" },
    { href: "/טכניקות-טיפוס/", label: "טכניקות טיפוס" },
    { href: `/טכניקות-טיפוס/${technique.id}/`, label: technique.data.nameHe },
  ]}
  jsonLd={jsonLd}
>
  <Badge variant="olive">{categoryLabels[technique.data.category]}</Badge>
  <h1 class="mt-3 font-display text-3xl font-bold text-ink">
    {technique.data.nameHe}
  </h1>
  <p class="mt-1 font-mono text-sm text-ink-soft">{technique.data.nameEn}</p>

  <div class="prose-climbing mt-8 max-w-none leading-relaxed text-ink">
    <Content />
  </div>

  <a
    href="/טכניקות-טיפוס/"
    class="mt-10 inline-block font-body text-sm font-bold text-rope hover:underline"
  >
    → חזרה לכל הטכניקות
  </a>
</GuideLayout>
