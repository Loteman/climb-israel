---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopoBackground from "../../components/layout/TopoBackground.astro";
import Badge from "../../components/ui/Badge.astro";
import SectionDivider from "../../components/ui/SectionDivider.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "טיפוס בטבע (Outdoor) - מדריך מלא",
  description:
    "מה ההבדל בין בולדרינג לטיפוס ספורטיבי בטבע, אילו ציוד צריך לכל אחד, ומה שונה בבטיחות כשמטפסים על סלע אמיתי.",
};
---

<BaseLayout
  title="טיפוס בטבע (Outdoor) - מדריך מלא"
  description="מדריך לטיפוס על סלע טבעי: ההבדל בין בולדרינג לטיפוס ספורטיבי בטבע, אילו ציוד צריך, ומה שונה בבטיחות. כולל קישור למפת אתרי טבע בישראל."
  jsonLd={jsonLd}
>
  <section class="relative overflow-hidden border-b border-stone/40 py-14">
    <TopoBackground opacity={0.3} />
    <div class="relative mx-auto max-w-3xl px-4 sm:px-6">
      <Badge variant="olive">Outdoor</Badge>
      <h1 class="mt-3 font-display text-3xl font-bold text-ink sm:text-4xl">
        טיפוס בטבע
      </h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-ink-soft">
        טיפוס על סלע אמיתי הוא חוויה שונה לגמרי מאולם. אין אחיזות
        מסומנות, אין עובד אולם בסביבה, ותנאי השטח - מזג אוויר, יציבות
        הסלע, גישה - משתנים כל הזמן. זה גם המקום שבו רמת האחריות
        האישית עולה משמעותית.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <div class="border border-dashed border-stone/60 bg-paper-dark p-5">
      <p class="leading-relaxed text-ink-soft">
        <strong class="text-rust">לפני שיוצאים:</strong> טיפוס בטבע - במיוחד
        עם ציוד אבטחה מלא - כרוך בסיכון ממשי. האתר הזה הוא מדריך כללי
        ולא תחליף להדרכה מקצועית. יוצאים בפעם הראשונה? עשו זאת עם מטפסים
        מנוסים או מדריך מוסמך.
      </p>
    </div>

    <SectionDivider class="my-10 text-stone/40" />

    <h2 class="font-display text-2xl font-bold text-ink">
      שני הסגנונות העיקריים בטבע - וההבדל ביניהם
    </h2>
    <p class="mt-2 leading-relaxed text-ink-soft">
      כמו באולם, יש בעיקר שני סגנונות שרוב המטפסים בטבע נעים ביניהם -
      אבל בטבע הפער בציוד ובסיכון ביניהם הרבה יותר גדול:
    </p>

    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      <div class="border border-stone/50 bg-paper-dark p-5">
        <p class="font-display text-lg font-bold text-ink">
          בולדרינג בטבע
        </p>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">
          טיפוס על סלעים נמוכים בלי חבל, עם{" "}
          <a href="/ציוד-טיפוס/crash-pad/" class="font-bold text-rope hover:underline">קראש פאד</a>{" "}
          נייד במקום מזרן קבוע. <strong class="text-rust">הציוד הכי פשוט
          מבין השניים</strong> - אבל הקרקע לא תמיד אחידה כמו באולם, ורצוי
          תמיד לטפס עם "ספוטר" (חבר שעוזר לכוון את הנפילה).
        </p>
      </div>
      <div class="border border-stone/50 bg-paper-dark p-5">
        <p class="font-display text-lg font-bold text-ink">
          טיפוס ספורטיבי / הובלה בטבע
        </p>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">
          טיפוס על סלע עם בולטים קבועים בסלע וחבל. <strong class="text-rust">
          דורש רכיב ציוד מלא, שותף מאובטח, וניסיון בקריאת עוגנים
          ותחנות</strong> - הסיכון הפיזי גבוה משמעותית מבולדרינג, ופציעה
          כאן יכולה להיות רצינית בהרבה.
        </p>
        <a href="/סגנונות-טיפוס/sport-climbing/" class="mt-3 inline-block font-body text-sm font-bold text-rope hover:underline">
          קראו עוד ←
        </a>
      </div>
    </div>
    <p class="mt-4 text-sm leading-relaxed text-ink-soft">
      מעבר לשניים האלה יש גם{" "}
      <a href="/סגנונות-טיפוס/trad/" class="font-bold text-rope hover:underline">טראד</a>{" "}
      (שבו מכניסים בעצמכם ציוד אבטחה לסדקים, בלי בולטים קבועים) ו-
      <a href="/סגנונות-טיפוס/multi-pitch/" class="font-bold text-rope hover:underline">מולטי-פיץ'</a>{" "}
      (מצוקים ארוכים שדורשים כמה קטעי טיפוס) - שני סגנונות מתקדמים
      שדורשים ניסיון וקורסים ייעודיים.
    </p>

    <SectionDivider class="my-10 text-stone/40" />

    <h2 class="font-display text-2xl font-bold text-ink">איזה ציוד צריך</h2>

    <div class="mt-5 space-y-5">
      <div>
        <p class="font-display font-bold text-ink">לבולדרינג בטבע</p>
        <p class="mt-1 text-sm leading-relaxed text-ink-soft">
          <a href="/ציוד-טיפוס/climbing-shoes/" class="font-bold text-rope hover:underline">נעלי טיפוס</a>,{" "}
          <a href="/ציוד-טיפוס/chalk/" class="font-bold text-rope hover:underline">מגנזיום</a>,{" "}
          ו<a href="/ציוד-טיפוס/crash-pad/" class="font-bold text-rope hover:underline">קראש פאד</a>{" "}
          - ורצוי לא לטפס לבד, גם אם זה "רק" בולדרינג.
        </p>
      </div>
      <div>
        <p class="font-display font-bold text-ink">
          לטיפוס ספורטיבי / הובלה בטבע
        </p>
        <p class="mt-1 text-sm leading-relaxed text-ink-soft">
          נעליים ומגנזיום, ובנוסף:{" "}
          <a href="/ציוד-טיפוס/harness/" class="font-bold text-rope hover:underline">רתמה</a>,{" "}
          <a href="/ציוד-טיפוס/dynamic-rope/" class="font-bold text-rope hover:underline">חבל דינמי</a>,{" "}
          <a href="/ציוד-טיפוס/quickdraws/" class="font-bold text-rope hover:underline">ראנרים/קוויקדרו</a>,{" "}
          <a href="/ציוד-טיפוס/belay-devices/" class="font-bold text-rope hover:underline">מכשיר אבטחה</a>,{" "}
          <a href="/ציוד-טיפוס/carabiners/" class="font-bold text-rope hover:underline">טבעות ננעלות</a>,{" "}
          ו<strong class="text-rust"><a href="/ציוד-טיפוס/helmet/" class="font-bold text-rope hover:underline">קסדה - חובה</a></strong>,{" "}
          לא אופציונלי כמו באולם. לירידה מעוגן בטוח, גם{" "}
          <a href="/ציוד-טיפוס/pas/" class="font-bold text-rope hover:underline">רצועת עיגון אישית (PAS)</a>{" "}
          שימושית מאוד.
        </p>
      </div>
    </div>

    <SectionDivider class="my-10 text-stone/40" />

    <h2 class="font-display text-2xl font-bold text-ink">
      מה שונה בבטיחות
    </h2>
    <ul class="mt-4 space-y-2 text-ink">
      <li>
        <strong class="text-rust">קסדה תמיד</strong> - אבנים מדורדרות
        ופגיעה בקיר בנפילה הן סיכון אמיתי שלא קיים באולם.
      </li>
      <li>
        <strong class="text-rust">בדקו תנאי מזג אוויר וסלע</strong> - סלע
        רטוב חלק ומסוכן, וחום קיצוני משפיע על החיכוך ועל הכוח שלכם.
      </li>
      <li>
        <strong class="text-rust">שתפו מישהו בתוכנית שלכם</strong> - לאן
        יוצאים ומתי מצפים לחזור, במיוחד באתרים מרוחקים.
      </li>
      <li>
        <strong class="text-rust">מידע על האתר משתנה</strong> - בולטים
        מחלידים, גישה שנחסמת, עדכונים על מצב הסלע - כדאי לבדוק מידע
        עדכני ולא להסתמך רק על מה שקראתם כאן.
      </li>
    </ul>

    <div class="mt-10 border border-dashed border-stone/60 bg-paper-dark p-5">
      <p class="font-display font-bold text-ink">איפה יש אתרי טבע?</p>
      <p class="mt-2 text-sm leading-relaxed text-ink-soft">
        מהצפון ועד הערבה - מצוקי הובלה, ופארק תמנע לבולדרינג בטבע.
      </p>
      <a
        href="/מקומות-טיפוס/?kind=crag"
        class="mt-3 inline-block font-body text-sm font-bold text-rope hover:underline"
      >
        לכל אתרי הטבע בישראל ←
      </a>
    </div>

    <p class="mt-8 text-ink-soft">
      עוד לא טיפסתם באולם? זו בדרך כלל נקודת ההתחלה הטובה ביותר.{" "}
      <a href="/טיפוס-באולם/" class="font-bold text-rope hover:underline">קראו על טיפוס באולם ←</a>
    </p>
  </section>
</BaseLayout>
